# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
# "gemini" (default, has a genuine standing free tier) or "anthropic" (requires paid credits).
LLM_PROVIDER=gemini

# Required when LLM_PROVIDER=gemini. Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required when LLM_PROVIDER=anthropic. Get one at https://console.anthropic.com (paid — no
# standing free tier; this project defaults to Gemini specifically because of that).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Database ---
# MongoDB connection string (Atlas free-tier cluster is fine). Used by the Express app.
# Not required to run the batch CLI (scripts/evaluate.ts) — it writes directly to a JSON file.
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# --- Sessions ---
# Random secret used to sign session identifiers. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Server ---
# development | test | production — controls the SSRF guard's private/loopback exception
# (loopback is only ever permitted when NODE_ENV !== production, so the documented
# http://localhost:8099/acme/ batch fixture works from a clean clone).
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API with credentials (CORS allow-list).
# In production this must be the deployed frontend's exact origin.
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (frontend/.env.local) ---
# Base URL the Next.js app calls for the Express API.
NEXT_PUBLIC_API_URL=http://localhost:4000
